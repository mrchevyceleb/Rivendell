PORT=8091
HOST=0.0.0.0
ELROND_WORKSPACE_PATH=/path/to/your/workspace

# Keep false unless you want queued jobs to spawn real Claude Code processes.
RIVENDELL_WORKER_ENABLED=true
RIVENDELL_WORKER_RUNNER=dry-run
RIVENDELL_WORKER_POLL_MS=10000

# Server-only Supabase access. Required for durable queue/events.
SUPABASE_URL=https://iycloielqcjnjqddeuet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Railway MCP bridge. Routes fall back to local mock data when unset.
RAILWAY_MCP_URL=
ASSISTANT_MCP_TOKEN=

# Existing assistant-mcp admin backend. Rivendell reads MCP_AUTH_TOKEN from
# ASSISTANT-HUB/assistant-mcp/server/.env by default, so this only needs
# overriding if the Railway URL or token changes.
ASSISTANT_ADMIN_BASE_URL=https://matt-assistant-production.up.railway.app
ASSISTANT_ADMIN_TOKEN=
ASSISTANT_MCP_ENV_PATH=/path/to/assistant-mcp/server/.env
