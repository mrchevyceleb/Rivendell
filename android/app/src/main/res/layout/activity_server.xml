<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="48dp"
        android:paddingEnd="28dp"
        android:paddingBottom="40dp">

        <ImageView
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:contentDescription="@string/ship_mark"
            android:src="@mipmap/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.34"
            android:text="@string/sign"
            android:textAllCaps="true"
            android:textColor="@color/brass"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/where_is_the_ship"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/server_help"
            android:textColor="@color/ink_mute"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/server_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:autofillHints="url"
            android:background="@drawable/bg_field"
            android:fontFamily="monospace"
            android:hint="@string/server_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_faint"
            android:textCursorDrawable="@null"
            android:textSize="14sp" />

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:stateListAnimator="@null"
            android:text="@string/materialise"
            android:textAllCaps="false"
            android:textColor="@color/on_brass"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:minHeight="22dp"
            android:textColor="@color/ink_mute"
            android:textSize="13sp" />

        <Button
            android:id="@+id/skip_check"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/save_without_check"
            android:textAllCaps="false"
            android:textColor="@color/ink_faint"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="monospace"
            android:textColor="@color/ink_faint"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
