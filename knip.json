{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["public/sw.js"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "server": {
      "entry": ["scripts/team-mcp.mjs"],
      "project": ["src/**/*.ts"]
    },
    "jarvis-agent": {
      "project": ["src/**/*.ts"]
    }
  }
}
